  IIF(
    [Measures].[Active Players] = 0,
    NULL,
    [Measures].[GGR] / [Measures].[Active Players]
  ),
VISIBLE = 1,
FORMAT_STRING = "Currency",
DISPLAY_FOLDER = 'Player'; 



