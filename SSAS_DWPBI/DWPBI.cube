  <MdxScripts>
    <MdxScript dwd:design-time-name="b54b1ba7-9541-4970-b324-676a5084d6b6">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;               
                      
CREATE MEMBER CURRENTCUBE.[Measures].[USD Valid Stake]
 AS [Measures].[USD Stake] - [Measures].[USD Refund], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Calculated Measures';                               
CREATE MEMBER CURRENTCUBE.[Measures].[USD Valid Payout]
 AS [Measures].[USD Payout] - [Measures].[USD Refund], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Calculated Measures';                                      

CREATE MEMBER CURRENTCUBE.[Measures].[Bets Real Sum]
 AS [Measures].[RealTicket], 
FORMAT_STRING = "#,##0;(#,##0)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Betting';     



CREATE MEMBER CURRENTCUBE.[Measures].[Bets Real Sum Prev Month]
 AS (ParallelPeriod(
            [Date].[Month].[Month], 1,
            [Date].[Month].CurrentMember
        ),
        [Measures].[Bets Real Sum]), 
FORMAT_STRING = "#,##0.00;(#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Betting';                
                  
CREATE MEMBER CURRENTCUBE.[Measures].[Bets Real Sum Var%] 
AS
    IIF(
        IsEmpty([Measures].[Bets Real Sum Prev Month]) OR [Measures].[Bets Real Sum Prev Month] = 0,
        NULL,
        ([Measures].[Bets Real Sum] - [Measures].[Bets Real Sum Prev Month])
        / [Measures].[Bets Real Sum Prev Month]
    ),
FORMAT_STRING = "Percent",
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Betting';               

CREATE MEMBER CURRENTCUBE.[Measures].[Bets Real Sum Delta]
 AS IIF(
        IsEmpty([Measures].[Bets Real Sum Prev Month]) OR [Measures].[Bets Real Sum Prev Month] = 0,
        NULL,
        ([Measures].[Bets Real Sum] - [Measures].[Bets Real Sum Prev Month])
    ), 
FORMAT_STRING = "#,##0.00;(#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Betting';    



CREATE MEMBER CURRENTCUBE.[Measures].[MoM text]
 AS "MoM%", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';               

CREATE MEMBER CURRENTCUBE.[Measures].[MoM Change]
 AS "MoM Change", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';                  


// GGR
CREATE MEMBER CURRENTCUBE.[Measures].[GGR]
 AS [Measures].[USD Valid Stake] - [Measures].[USD Win], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';      


CREATE MEMBER CURRENTCUBE.[Measures].[GGR Prev Month]
 AS (ParallelPeriod(
            [Date].[Month].[Month], 1,
            [Date].[Month].CurrentMember
        ),
        [Measures].[GGR]), 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';                  

CREATE MEMBER CURRENTCUBE.[Measures].[GGR All Game Category]
 AS  SUM(
        {[Game].[Game Category Hierarchy].[Category].Members}, 
        ([Measures].[GGR])
    ), 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';                    
   
CREATE MEMBER CURRENTCUBE.[Measures].[GGR All Game Category Pre Month]
 AS (ParallelPeriod(
            [Date].[Month].[Month], 1,
            [Date].[Month].CurrentMember
        ),
        [Measures].[GGR All Game Category]),  
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';          


CREATE MEMBER CURRENTCUBE.[Measures].[GGR All Game Category Delta] 
 AS  SUM(
        {[Game].[Game Category Hierarchy].[Category].Members}, 
        ([Measures].[GGR Delta])
    ), 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';                  

CREATE MEMBER CURRENTCUBE.[Measures].[GGR All Game Category Var%] 
AS
    IIF(
        IsEmpty([Measures].[GGR All Game Category Pre Month]) OR [Measures].[GGR All Game Category Pre Month] = 0,
        NULL,
        ([Measures].[GGR All Game Category] - [Measures].[GGR All Game Category Pre Month])
        / [Measures].[GGR All Game Category Pre Month]
    ),
FORMAT_STRING = "Percent",
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';      


CREATE MEMBER CURRENTCUBE.[Measures].[Selected Metric] AS 
IIF(
    [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Turnover],
    [Measures].[Turnover],
    IIF(
        [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[GGR],
        [Measures].[GGR],
        IIF(
            [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Win Sum],
            [Measures].[Win Sum],
            IIF(
                [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Bets Sum],
                [Measures].[Bets Sum],
                IIF(
                    [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Active Players],
                    [Measures].[Active Players],
                    IIF(
                        [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Active Players (Hourly)],
                        [Measures].[Active Players (Hourly)],
                        NULL
                    )
                )
            )
        )
    )
),
VISIBLE = 1, 
DISPLAY_FOLDER = 'Dynamic Metrics',
FORMAT_STRING = "#,##0.00";  

/*
CREATE MEMBER CURRENTCUBE.[Measures].[Selected Metric] AS 
IIF(
    [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Turnover],
    [Measures].[Turnover],
    IIF(
        [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[GGR],
        [Measures].[GGR],
        IIF(
            [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Win Sum],
            [Measures].[Win Sum],
            IIF(
                [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Bets Sum],
                [Measures].[Bets Sum],
                IIF(
                    [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Active Players],
                    [Measures].[Active Players],
                    NULL
                )
            )
        )
    )
),
VISIBLE = 1, 
DISPLAY_FOLDER = 'Dynamic Metrics',
FORMAT_STRING = "#,##0.00";  
*/

