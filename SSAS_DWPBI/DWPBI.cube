AS
    IIF(
        IsEmpty([Measures].[Turnover Prev Month]) OR [Measures].[Turnover Prev Month] = 0,
        NULL,
        ([Measures].[Turnover] - [Measures].[Turnover Prev Month])
        / [Measures].[Turnover Prev Month]
    ),
FORMAT_STRING = "Percent",
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';   


CREATE MEMBER CURRENTCUBE.[Measures].[Turnover Delta] 
AS
    IIF(
        IsEmpty([Measures].[Turnover Prev Month]) OR [Measures].[Turnover Prev Month] = 0,
