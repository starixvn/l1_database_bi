  <MdxScripts>
    <MdxScript dwd:design-time-name="ec214ca4-be87-4204-ad1d-fe85af575ee7">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;                
                      
CREATE MEMBER CURRENTCUBE.[Measures].[USD Valid Stake]
 AS [Measures].[USD Stake] - [Measures].[USD Refund], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Calculated Measures';                                

CREATE MEMBER CURRENTCUBE.[Measures].[USD Valid Payout]
 AS [Measures].[USD Payout] - [Measures].[USD Refund], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Calculated Measures';                                       

CREATE MEMBER CURRENTCUBE.[Measures].[USD Max Stake]
 AS [Measures].[Maximum USD Stake], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Calculated Measures';                                       

CREATE MEMBER CURRENTCUBE.[Measures].[USD Refund Stake]
 AS [Measures].[USD Refund], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Calculated Measures';  

CREATE MEMBER CURRENTCUBE.[Measures].[Bets Refund Sum]
 AS [Measures].[Real Refund Bet], 
FORMAT_STRING = "#,##0;(#,##0)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Betting';  

CREATE MEMBER CURRENTCUBE.[Measures].[Bets Real Sum]
 AS [Measures].[RealTicket], 
FORMAT_STRING = "#,##0;(#,##0)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Betting';      

CREATE MEMBER CURRENTCUBE.[Measures].[Bets Win Sum]
 AS [Measures].[Bet Win], 
FORMAT_STRING = "#,##0;(#,##0)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Betting';      

CREATE MEMBER CURRENTCUBE.[Measures].[Bets Sum Contri % by Game]
 AS 
   IIF(
    ([Measures].[Bets Sum], [Game].[Game].DefaultMember) = 0,
    NULL,
    [Measures].[Bets Sum]/ ([Measures].[Bets Sum], [Game].[Game].DefaultMember)
   ),
VISIBLE = 1,
FORMAT_STRING = "Percent",
DISPLAY_FOLDER = 'Revenue &amp; Profit'; 

CREATE MEMBER CURRENTCUBE.[Measures].[Average Stake per Bet]
AS
  IIF(
    [Measures].[Ticket Count] = 0,
    NULL,
    [Measures].[USD Stake] / [Measures].[Ticket Count]
  ),
VISIBLE = 1,
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
DISPLAY_FOLDER = 'Betting'; 


CREATE MEMBER CURRENTCUBE.[Measures].[Bets Real Sum Prev Month]
 AS (ParallelPeriod(
            [Date].[Month].[Month], 1,
            [Date].[Month].CurrentMember
        ),
        [Measures].[Bets Real Sum]), 
FORMAT_STRING = "#,##0.00;(#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Betting';                 
                  
CREATE MEMBER CURRENTCUBE.[Measures].[Bets Real Sum Var%] 
AS
    IIF(
        IsEmpty([Measures].[Bets Real Sum Prev Month]) OR [Measures].[Bets Real Sum Prev Month] = 0,
        NULL,
        ([Measures].[Bets Real Sum] - [Measures].[Bets Real Sum Prev Month])
        / [Measures].[Bets Real Sum Prev Month]
    ),
FORMAT_STRING = "Percent",
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Betting';                

CREATE MEMBER CURRENTCUBE.[Measures].[Bets Real Sum Delta]
 AS IIF(
        IsEmpty([Measures].[Bets Real Sum Prev Month]) OR [Measures].[Bets Real Sum Prev Month] = 0,
        NULL,
        ([Measures].[Bets Real Sum] - [Measures].[Bets Real Sum Prev Month])
    ), 
FORMAT_STRING = "#,##0.00;(#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Betting';     




CREATE MEMBER CURRENTCUBE.[Measures].[MoM text]
 AS "MoM%", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';                

CREATE MEMBER CURRENTCUBE.[Measures].[MoM Change]
 AS "MoM Change", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';                   

CREATE MEMBER CURRENTCUBE.[Measures].[YoY text]
 AS "YoY%", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';    

CREATE MEMBER CURRENTCUBE.[Measures].[YoY Change]
 AS "YoY Change", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';                   

CREATE MEMBER CURRENTCUBE.[Measures].[Text]
 AS "Text", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';        

CREATE MEMBER CURRENTCUBE.[Measures].[Win Amount Text]
 AS "Win Amount", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';                   

CREATE MEMBER CURRENTCUBE.[Measures].[Win Rate Text]
 AS "Win Rate", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';     

CREATE MEMBER CURRENTCUBE.[Measures].[Win Rate by Amount Text]
 AS "Win Rate by Amount", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';           

// GGR
CREATE MEMBER CURRENTCUBE.[Measures].[GGR]
 AS [Measures].[USD Valid Stake] - [Measures].[USD Win], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';       


CREATE MEMBER CURRENTCUBE.[Measures].[GGR Prev Month]
 AS (ParallelPeriod(
            [Date].[Month].[Month], 1,
            [Date].[Month].CurrentMember
        ),
        [Measures].[GGR]), 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';                   

CREATE MEMBER CURRENTCUBE.[Measures].[GGR All Game Category]
 AS  SUM(
        {[Game].[Game Category Hierarchy].[Category].Members}, 
        ([Measures].[GGR])
    ), 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';                     
   
CREATE MEMBER CURRENTCUBE.[Measures].[GGR All Game Category Pre Month]
 AS (ParallelPeriod(
            [Date].[Month].[Month], 1,
            [Date].[Month].CurrentMember
        ),
        [Measures].[GGR All Game Category]),  
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';           


CREATE MEMBER CURRENTCUBE.[Measures].[GGR All Game Category Delta] 
 AS  SUM(
        {[Game].[Game Category Hierarchy].[Category].Members}, 
        ([Measures].[GGR Delta])
    ), 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';                   

