        NULL,
        ([Measures].[GGR] - [Measures].[GGR Prev Year])
    ),
FORMAT_STRING = "$#,##0.00;($#,##0.00)",
VISIBLE = 1,
DISPLAY_FOLDER = 'Revenue &amp; Profit'; 


CREATE MEMBER CURRENTCUBE.[Measures].[Selected Metric] AS 
IIF(
    [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Turnover],
    [Measures].[Turnover],
    IIF(
        [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[GGR],
        [Measures].[GGR],
        IIF(
            [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Win Sum],
            [Measures].[Win Sum],
            IIF(
                [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Bets Sum],
                [Measures].[Bets Sum],
                IIF(
                    [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Active Players],
                    [Measures].[Active Players],
                    IIF(
                        [MetricSelector].[Metric Name].CURRENTMEMBER IS [MetricSelector].[Metric Name].&amp;[Active Players (Hourly)],
                        [Measures].[Active Players (Hourly)],
                        NULL
                    )
                )
            )
        )
    )
),
VISIBLE = 1, 
DISPLAY_FOLDER = 'Dynamic Metrics',
FORMAT_STRING = "#,##0.00";   


CREATE MEMBER CURRENTCUBE.[Measures].[GGR Var%] 
AS
    IIF(
        IsEmpty([Measures].[GGR Prev Month]) OR [Measures].[GGR Prev Month] = 0,
        NULL,
        ([Measures].[GGR] - [Measures].[GGR Prev Month])
        / [Measures].[GGR Prev Month]
    ),
FORMAT_STRING = "Percent",
