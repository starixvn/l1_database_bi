 AS "YoY%", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';    

CREATE MEMBER CURRENTCUBE.[Measures].[YoY Change]
 AS "YoY Change", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';                   

CREATE MEMBER CURRENTCUBE.[Measures].[Text]
 AS "Text", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';        

CREATE MEMBER CURRENTCUBE.[Measures].[Win Amount Text]
 AS "Win Amount", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';                   

CREATE MEMBER CURRENTCUBE.[Measures].[Win Rate Text]
 AS "Win Rate", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';     

CREATE MEMBER CURRENTCUBE.[Measures].[Win Rate by Amount Text]
 AS "Win Rate by Amount", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Text';           

// GGR
CREATE MEMBER CURRENTCUBE.[Measures].[GGR]
 AS [Measures].[USD Valid Stake] - [Measures].[USD Payout], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';       


