 AS [Measures].[USD Loss], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';       


CREATE MEMBER CURRENTCUBE.[Measures].[Loss Sum Prev Month]
 AS (ParallelPeriod(
