CREATE MEMBER CURRENTCUBE.[Measures].[RTP %]
 AS [Measures].[USD Valid Payout]/[Measures].[USD Valid Stake], 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Performance Ratios';                            

   
CREATE MEMBER CURRENTCUBE.[Measures].[Refund Rate]
 AS [Measures].[USD Refund]/[Measures].[USD Stake], 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Bet Quality';                               


CREATE MEMBER CURRENTCUBE.[Measures].[Bet Size]
 AS [Measures].[USD Stake]/[Measures].[Ticket Count], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Betting';                              


CREATE MEMBER CURRENTCUBE.[Measures].[Win Rate]
 AS [Measures].[USD Win]/[Measures].[Ticket Count], 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Performance Ratios';                   


CREATE MEMBER CURRENTCUBE.[Measures].[Active Players Prev Month]
 AS (
        ParallelPeriod([Date].[Month].[Month], 1, [Date].[Month].CurrentMember),
        [Measures].[Active Players]
    ),
FORMAT_STRING = "#,##0.00;(#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Player';           

 

CREATE MEMBER CURRENTCUBE.[Measures].[Active Players Var%] 
AS
    IIF(
        IsEmpty([Measures].[Active Players Prev Month]) OR [Measures].[Active Players Prev Month] = 0,
        NULL,
        ([Measures].[Active Players] - [Measures].[Active Players Prev Month])
        / [Measures].[Active Players Prev Month]
    ),
FORMAT_STRING = "Percent",
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Player';               

CREATE MEMBER CURRENTCUBE.[Measures].[Active Players Delta] 
AS
    IIF(
        IsEmpty([Measures].[Active Players Prev Month]) OR [Measures].[Active Players Prev Month] = 0,
        NULL,
        ([Measures].[Active Players] - [Measures].[Active Players Prev Month])
    ),
FORMAT_STRING = "$#,##0.00;($#,##0.00)",
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Player';           

CREATE MEMBER CURRENTCUBE.[Measures].[TO % by GameCategory] AS
    IIF(
        ( [Game].[Game Category Hierarchy].[Category].ALLMEMBERS, [Measures].[USD Valid Stake] ) = 0,
        NULL,
        [Measures].[USD Valid Stake] /
        ( [Game].[Game Category Hierarchy].[Category].ALLMEMBERS, [Measures].[USD Valid Stake] )
    ),
FORMAT_STRING = "Percent",
VISIBLE = 1,
DISPLAY_FOLDER = 'Revenue &amp; Profit';   


-- returning player xdays
CREATE MEMBER CURRENTCUBE.[Measures].[Returning Players 7d] AS
	COUNT(
		FILTER(
			[Player].[PlayerID].[PlayerID].MEMBERS,
			(
				([Measures].[Active Players], [Date].[Date Hierarchy].CurrentMember) &gt; 0
			)
			AND
			(
				SUM(
					LASTPERIODS(6, [Date].[Date Hierarchy].CurrentMember.PREVMEMBER),
					([Measures].[Active Players], [Player].[PlayerID].CurrentMember)
				) = 0
			)
		)
	),
FORMAT_STRING = "#,##0.00;(#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Player';

CREATE MEMBER CURRENTCUBE.[Measures].[Returning Players 14d] AS
	COUNT(
		FILTER(
			[Player].[PlayerID].[PlayerID].MEMBERS,
			(
				([Measures].[Active Players], [Date].[Date Hierarchy].CurrentMember) &gt; 0
			)
			AND
			(
				SUM(
					LASTPERIODS(13, [Date].[Date Hierarchy].CurrentMember.PREVMEMBER),
					([Measures].[Active Players], [Player].[PlayerID].CurrentMember)
				) = 0
			)
		)
	),
FORMAT_STRING = "#,##0.00;(#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Player';

CREATE MEMBER CURRENTCUBE.[Measures].[Returning Players 30d] AS
	COUNT(
		FILTER(
			[Player].[PlayerID].[PlayerID].MEMBERS,
			(
				([Measures].[Active Players], [Date].[Date Hierarchy].CurrentMember) &gt; 0
			)
			AND
			(
				SUM(
					LASTPERIODS(30, [Date].[Date Hierarchy].CurrentMember.PREVMEMBER),
					([Measures].[Active Players], [Player].[PlayerID].CurrentMember)
				) = 0
			)
		)
	),
FORMAT_STRING = "#,##0.00;(#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Player';


CREATE MEMBER CURRENTCUBE.[Measures].[Retention Rate %] AS
    IIF(
        COUNT(
            NONEMPTY(
                [Player].[PlayerID].[PlayerID],
                ([Measures].[Active Players], [Date].[Date Hierarchy].CurrentMember.PREVMEMBER)
            )
        ) &gt; 0,

        1.0 *
        COUNT(
            FILTER(
                NONEMPTY(
                    [Player].[PlayerID].[PlayerID],
                    ([Measures].[Active Players], [Date].[Date Hierarchy].CurrentMember.PREVMEMBER)
                ),
                (
                    ([Measures].[Active Players], [Date].[Date Hierarchy].CurrentMember,
                     [Player].[PlayerID].CurrentMember) &gt; 0
                )
            )
        )
        /
        COUNT(
            NONEMPTY(
                [Player].[PlayerID].[PlayerID],
                ([Measures].[Active Players], [Date].[Date Hierarchy].CurrentMember.PREVMEMBER)
            )
        ) ,

        NULL
    ),
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Player';

CREATE MEMBER CURRENTCUBE.[Measures].[Churn Rate %] AS
    IIF(
        NOT ISEMPTY([Measures].[Retention Rate %]),
        1 - [Measures].[Retention Rate %],
        NULL
    ),
FORMAT_STRING = "Percent", 
VISIBLE = 1,
DISPLAY_FOLDER = 'Player';


</Text>
