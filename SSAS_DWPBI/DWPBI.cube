CREATE MEMBER CURRENTCUBE.[Measures].[Winloss Sum]
 AS [Measures].[USD Winloss], 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';               

CREATE MEMBER CURRENTCUBE.[Measures].[Winloss Sum Prev Month]
 AS (ParallelPeriod(
            [Date].[Month].[Month], 1,
            [Date].[Month].CurrentMember
        ),
        [Measures].[Winloss Sum]), 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
