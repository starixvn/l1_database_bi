AS 
    ([Measures].[GGR], 
     ParallelPeriod(
        [Date].[Year].[Year], 
        1, 
        [Date].[Year].CurrentMember)
    ),
FORMAT_STRING = "$#,##0.00;($#,##0.00)",
VISIBLE = 1,
DISPLAY_FOLDER = 'Revenue &amp; Profit'; 
       
