    ),
FORMAT_STRING = "$#,##0.00;($#,##0.00)",
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';        


          
CREATE MEMBER CURRENTCUBE.[Measures].[Turnover]
 AS [Measures].[USD Valid Stake], 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';           

CREATE MEMBER CURRENTCUBE.[Measures].[Turnover Prev Month]
 AS (ParallelPeriod(
            [Date].[Month].[Month], 1,
            [Date].[Month].CurrentMember
        ),
        [Measures].[Turnover]), 
FORMAT_STRING = "$#,##0.00;($#,##0.00)", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Revenue &amp; Profit';                
                  
